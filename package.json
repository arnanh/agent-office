{
  "name": "agent-office",
  "version": "0.1.0",
  "private": true,
  "description": "A cozy 3D office where your T3 Code threads work as little agents.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && node server/main.ts",
    "serve": "node server/main.ts",
    "typecheck": "tsc --noEmit",
    "app": "node scripts/build-app.ts",
    "app:install": "node scripts/build-app.ts --install",
    "app:icon": "node scripts/render-icon.ts"
  },
  "dependencies": {
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.9.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.170.0",
    "electron": "^45.2.3",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2",
    "vite": "^6.4.5"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.321"
  }
}
